---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BuyBox from '../../../components/BuyBox.astro';
import ProductCard from '../../../components/ProductCard.astro';
import PartImage from '../../../components/PartImage.astro';
import FaqList from '../../../components/FaqList.astro';
import JsonLd from '../../../components/JsonLd.astro';
import Icon from '../../../components/Icon.astro';
import { usd, CATEGORY_ICONS } from '../../../config/site';
import { PRODUCT_STRIP, COPY, type QA } from '../../../content/copy';
import {
  products, productsBySku, categoryName, primaryFitment, fitmentLabel, fitsSentence, soldAsLabel, unitWord,
  productUrl, kitUrl, kitsContaining, relatedProducts, fitTitle, fitDescription, fitmentAttr, vehicles,
} from '../../../lib/catalog';
import { offerFor } from '../../../lib/schema';
import { imageUrl } from '../../../lib/images';

export function getStaticPaths() {
  return products.map((p) => ({ params: { category: p.category, slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props;
const cat = categoryName(p.category);
const fit = primaryFitment(p);
const main = p.fitment[0];
const label = soldAsLabel(p);
const unit = unitWord(p);
const url = productUrl(p);
const boughtWith = p.boughtWith.map((s) => productsBySku.get(s)).filter((x): x is NonNullable<typeof x> => !!x);
const inKits = kitsContaining(p.sku);
const related = relatedProducts(p, 4);
const vehicleLink = (f: typeof main) => {
  const v = vehicles.find((x) => x.make === f.make && x.model === f.model);
  return v ? `/vehicles/${v.makeSlug}/${v.modelSlug}/` : null;
};

const titleFit = main.universal ? 'Universal' : `${main.make} ${main.model} ${main.from}-${main.to}`;
const shortFit = main.universal ? 'Universal' : `${main.model} ${main.from}-${main.to}`;
const title = fitTitle(`${p.name} for ${titleFit} | BayStock`, `${p.name} for ${titleFit}`, `${p.name} for ${shortFit}`, `${p.name} ${p.sku}`);
const description = fitDescription(`${p.shortDescription} Fits ${fit}. ${usd(p.prices[0].price)} each, less in quantity. Free shipping over $250.`);
const h1Fit = main.universal ? 'Universal fit' : `Fits ${fit}`;
const alt = `${p.name} for ${fit}`;

const qa: QA[] = [
  { q: `Which vehicles does the ${p.name} (${p.sku}) fit?`, a: `${fitsSentence(p)} Check the full fitment table on this page before ordering.` },
  {
    q: `What is the unit price of ${p.sku} at 10 and at 50?`,
    a: `At 10 to 49 the unit price is ${usd(p.prices[2].price)} ${unit}, and at 50 or more it is ${usd(p.prices[3].price)} ${unit}. A single ${unit === 'each' ? 'unit' : unit} is ${usd(p.prices[0].price)}.`,
  },
  {
    q: `Which original part numbers does ${p.sku} replace?`,
    a: p.oeRefs.length
      ? `It replaces original part number${p.oeRefs.length > 1 ? 's' : ''} ${p.oeRefs.join(', ')}. ${COPY.oeNote}`
      : 'No original part numbers are listed for this part yet. Check the fitment table, or contact us with your vehicle details before ordering.',
  },
];

const img = (await imageUrl('products', p.imageMain, Astro.site!)) ?? new URL('/og-image.png', Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.sku,
  mpn: p.sku,
  ...(p.gtin ? { gtin: p.gtin } : {}),
  brand: { '@type': 'Brand', name: p.brand },
  description: p.description,
  category: cat,
  image: [img],
  url: new URL(url, Astro.site).href,
  weight: { '@type': 'QuantitativeValue', value: p.weightLb, unitCode: 'LBR' },
  offers: offerFor({ url, price: p.prices[0].price, inStock: p.inStock, site: Astro.site! }),
};
---
<BaseLayout title={title} description={description} ogType="product" ogImage={img}>
  <div class="container-bay py-6 md:py-8" data-track-view={p.sku} data-price={p.prices[0].price}>
    <!-- 1. Breadcrumb -->
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Parts', href: '/parts/' }, { name: cat, href: `/parts/${p.category}/` }, { name: p.name, href: url }]} />

    <div class="mt-5 grid gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- 2. Gallery -->
      <div class="lg:col-span-6">
        <div class="sticky top-36 overflow-hidden rounded-lg border border-line-200 bg-surface-0">
          <PartImage path={p.imageMain} alt={alt} eager sizes="(min-width: 1024px) 600px, 100vw" illustrative={p.imageType === 'illustrative'} label="long" class="aspect-square w-full" icon={CATEGORY_ICONS[p.category]} plain />
          {p.imageType === 'illustrative' && <p class="border-t border-line-200 px-4 py-2.5 text-[0.8125rem] text-text-600">{COPY.illustrative}</p>}
        </div>
      </div>

      <div class="lg:col-span-6">
        <!-- 3. SKU, H1, fitment summary -->
        <p class="tag-mono inline-flex items-center gap-2 rounded-sm border border-dashed border-text-900/40 px-2 py-1 text-sm">SKU {p.sku}</p>
        <h1 class="mt-3 text-[2.25rem] leading-[1.02] md:text-5xl">{p.name} — {h1Fit}</h1>
        <p class="mt-3 text-text-600">{fitsSentence(p)} <a href="#fitment" class="link">See all vehicles</a></p>
        <p data-fit-check={fitmentAttr(p)} hidden></p>

        <!-- 4. Price calculator -->
        <div class="mt-6">
          <BuyBox sku={p.sku} prices={p.prices} inStock={p.inStock} unit={unit} label={label} caseQty={p.caseQty} caRestricted={p.caRestricted} />
        </div>

        <!-- 5. Stock and shipping -->
        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          {p.inStock
            ? <span class="inline-flex items-center gap-2 font-semibold text-ok-green"><span class="h-2 w-2 rounded-full bg-ok-green"></span>In stock</span>
            : <span class="font-semibold text-alert-red">Out of stock</span>}
          <span class="inline-flex items-center gap-2 text-text-600"><Icon name="truck" size={18} />{COPY.shippingLine}</span>
        </div>

        <!-- 6. Why buy strip -->
        <ul class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line-200 bg-line-200 sm:grid-cols-4">
          {PRODUCT_STRIP.map((r) => (
            <li class="flex flex-col items-start gap-2 bg-surface-0 p-3 text-[0.8125rem] font-medium leading-tight">
              <Icon name={r.icon as any} size={20} class="text-text-900" />{r.text}
            </li>
          ))}
        </ul>

        <!-- 7. Key specifications -->
        <section class="mt-8" aria-labelledby="h-specs">
          <h2 id="h-specs" class="text-2xl">Key specifications</h2>
          <table class="mt-3 w-full overflow-hidden rounded-md border border-line-200 bg-surface-0 text-sm">
            <tbody class="divide-y divide-line-200">
              <tr><th scope="row" class="w-2/5 bg-surface-50 px-4 py-2.5 text-left font-medium">SKU</th><td class="tag-mono px-4 py-2.5">{p.sku}</td></tr>
              <tr><th scope="row" class="bg-surface-50 px-4 py-2.5 text-left font-medium">Brand</th><td class="px-4 py-2.5">{p.brand}</td></tr>
              {p.specs.map((s) => <tr><th scope="row" class="bg-surface-50 px-4 py-2.5 text-left font-medium">{s.key}</th><td class="px-4 py-2.5">{s.value}</td></tr>)}
              <tr><th scope="row" class="bg-surface-50 px-4 py-2.5 text-left font-medium">Sold as</th><td class="px-4 py-2.5">{label ?? 'Each'}{p.packSize > 1 && ` (${p.packSize} pieces)`}</td></tr>
              {p.caseQty && <tr><th scope="row" class="bg-surface-50 px-4 py-2.5 text-left font-medium">Case quantity</th><td class="tag-mono px-4 py-2.5">{p.caseQty}</td></tr>}
              <tr><th scope="row" class="bg-surface-50 px-4 py-2.5 text-left font-medium">Shipping weight</th><td class="tag-mono px-4 py-2.5">{p.weightLb} lb</td></tr>
              <tr><th scope="row" class="bg-surface-50 px-4 py-2.5 text-left font-medium">Warranty</th><td class="px-4 py-2.5">{p.warrantyMonths} months</td></tr>
              {p.gtin && <tr><th scope="row" class="bg-surface-50 px-4 py-2.5 text-left font-medium">GTIN</th><td class="tag-mono px-4 py-2.5">{p.gtin}</td></tr>}
            </tbody>
          </table>
        </section>

        <!-- 8. Description -->
        <section class="mt-8" aria-labelledby="h-desc">
          <h2 id="h-desc" class="text-2xl">Description</h2>
          <p class="mt-3 text-[1.0625rem] leading-relaxed">{p.description}</p>
        </section>
      </div>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <!-- 9. Fitment table -->
      <section id="fitment" aria-labelledby="h-fit">
        <h2 id="h-fit" class="text-3xl">Fitment</h2>
        <p class="mt-2 text-text-600">{fitsSentence(p)}</p>
        <table class="mt-4 w-full overflow-hidden rounded-md border border-line-200 bg-surface-0 text-sm">
          <thead class="bg-surface-50 text-left"><tr><th scope="col" class="px-4 py-2.5 font-medium">Make</th><th scope="col" class="px-4 py-2.5 font-medium">Model</th><th scope="col" class="px-4 py-2.5 font-medium">Years</th></tr></thead>
          <tbody class="divide-y divide-line-200">
            {p.fitment.map((f) => {
              const link = f.universal ? null : vehicleLink(f);
              return f.universal
                ? <tr><td class="px-4 py-2.5" colspan="3">Universal</td></tr>
                : <tr><td class="px-4 py-2.5">{f.make}</td><td class="px-4 py-2.5">{link ? <a href={link} class="link">{f.model}</a> : f.model}</td><td class="tag-mono px-4 py-2.5">{f.from === f.to ? f.from : `${f.from}–${f.to}`}</td></tr>;
            })}
          </tbody>
        </table>
      </section>

      <div class="space-y-8">
        <!-- 10. Original part numbers -->
        <section aria-labelledby="h-oe">
          <h2 id="h-oe" class="text-3xl">Replaces these original part numbers</h2>
          {p.oeRefs.length
            ? <ul class="mt-4 flex flex-wrap gap-2">{p.oeRefs.map((o) => <li class="tag-mono rounded border border-line-200 bg-surface-0 px-3 py-1.5 text-sm">{o}</li>)}</ul>
            : <p class="mt-3 text-text-600">No original part numbers are listed for this part yet.</p>}
          <p class="mt-3 text-sm text-text-600">{COPY.oeNote}</p>
        </section>

        <!-- 11. Warranty and returns -->
        <section aria-labelledby="h-wr" class="rounded-md border border-line-200 bg-surface-0 p-5">
          <h2 id="h-wr" class="text-2xl">Warranty and returns</h2>
          <p class="mt-2 text-text-600">Covered for {p.warrantyMonths} months from delivery against defects in materials and workmanship. Unused parts in original packaging can be returned within 30 days of delivery.</p>
          <p class="mt-3 flex gap-4 text-sm"><a href="/warranty/" class="link">Warranty details</a><a href="/returns/" class="link">Returns policy</a></p>
        </section>

        <!-- 12. Proposition 65 -->
        {p.prop65 && (
          <section aria-label="California Proposition 65 warning" class="flex gap-3 rounded-md border border-line-200 bg-surface-0 p-4 text-sm">
            <svg class="mt-0.5 shrink-0" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 1 21h22L12 2Z" fill="#FFC400" stroke="#14181D" stroke-width="1.5" stroke-linejoin="round" /><path d="M12 9v5M12 17v.5" stroke="#14181D" stroke-width="2" stroke-linecap="round" /></svg>
            <p><strong>California Proposition 65.</strong> {COPY.prop65}</p>
          </section>
        )}
      </div>
    </div>

    <!-- 13. Questions and answers -->
    <section class="mt-12" aria-labelledby="h-qa">
      <h2 id="h-qa" class="text-3xl">Questions about {p.sku}</h2>
      <div class="mt-4"><FaqList items={qa} /></div>
    </section>

    <!-- Frequently bought together -->
    {(boughtWith.length > 0 || inKits.length > 0) && (
      <section class="mt-12 rounded-lg border border-line-200 bg-surface-0 p-5 md:p-6" aria-labelledby="h-fbt">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="h-fbt" class="text-3xl">Frequently bought together</h2>
          {boughtWith.length > 0 && <button type="button" class="btn btn-primary" data-quick-add={[p.sku, ...boughtWith.filter((b) => b.inStock).map((b) => b.sku)].join(',')}>Add all</button>}
        </div>
        <ul class="mt-4 divide-y divide-line-200">
          {boughtWith.map((b) => (
            <li class="flex flex-wrap items-center gap-3 py-3">
              <div class="min-w-0 flex-1">
                <p class="tag-mono text-[0.75rem] text-text-600">{b.sku}</p>
                <a href={productUrl(b)} class="font-semibold no-underline hover:underline">{b.name}</a>
                <p class="text-[0.8125rem] text-text-600">Fits {primaryFitment(b)}{soldAsLabel(b) ? ` · ${soldAsLabel(b)}` : ''}</p>
              </div>
              <span class="tag-mono">{usd(b.prices[0].price)}</span>
              {b.inStock ? <button type="button" class="btn min-h-10 border border-text-900 px-4 text-sm" data-quick-add={b.sku}>Add</button> : <span class="text-sm text-alert-red">Out of stock</span>}
            </li>
          ))}
          {inKits.map((k) => (
            <li class="flex flex-wrap items-center gap-3 py-3">
              <div class="min-w-0 flex-1">
                <p class="tag-mono text-[0.75rem] text-text-600">{k.sku} · Kit</p>
                <a href={kitUrl(k)} class="font-semibold no-underline hover:underline">{k.name}</a>
                <p class="text-[0.8125rem] font-medium text-ok-green">Save {usd(k.separatePrice - k.prices[0].price)} against buying these parts separately.</p>
              </div>
              <span class="tag-mono">{usd(k.prices[0].price)}</span>
              {k.inStock ? <button type="button" class="btn min-h-10 border border-text-900 px-4 text-sm" data-quick-add={k.sku}>Add</button> : <span class="text-sm text-alert-red">Out of stock</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- 14. Shops also stock -->
    {related.length > 0 && (
      <section class="mt-12" aria-labelledby="h-rel">
        <h2 id="h-rel" class="text-3xl">Shops also stock</h2>
        <div class="mt-5 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
          {related.map((r) => <ProductCard product={r} />)}
        </div>
      </section>
    )}
  </div>
  <JsonLd data={ld} />
</BaseLayout>
