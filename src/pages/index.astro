---
// PHASE 1 PREVIEW. This page shows the foundation (tokens, type, signature elements,
// validated sample data) for owner approval. Phase 2 replaces it with the home page
// copy from spec section 6.
import BaseLayout from '../layouts/BaseLayout.astro';
import BayLine from '../components/BayLine.astro';
import TierStrip from '../components/TierStrip.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { products, kits, fitmentLabel, soldAsLabel } from '../lib/catalog';
import { SITE, RULES, CATEGORIES, SHIPPING_RATES, usd } from '../config/site';
import { PAYMENT_MODE } from 'astro:env/server';

const tokens = [
  { name: '--ink-900', hex: '#0E1114', use: 'Header, hero, and footer background', dark: true },
  { name: '--ink-700', hex: '#1B2026', use: 'Dark cards and panels', dark: true },
  { name: '--steel-500', hex: '#5B6673', use: 'Secondary text and borders on dark', dark: true },
  { name: '--surface-0', hex: '#FFFFFF', use: 'Product cards and tables' },
  { name: '--surface-50', hex: '#F4F5F7', use: 'Page background on catalog pages' },
  { name: '--text-900', hex: '#14181D', use: 'Body text on light surfaces', dark: true },
  { name: '--line-yellow', hex: '#FFC400', use: 'Primary buttons, savings badges, progress bar' },
  { name: '--link-blue', hex: '#1F5FBF', use: 'Text links on light surfaces', dark: true },
  { name: '--ok-green', hex: '#1E8E4E', use: 'In-stock and success states', dark: true },
  { name: '--alert-red', hex: '#C62828', use: 'Errors and out-of-stock', dark: true },
];

const showcase = ['cabin-air-filters', 'ignition-coils', 'brake-pads', 'suspension']
  .map((c) => products.find((p) => p.category === c))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const demo = products.find((p) => p.sku === 'BS-CAF-0012') ?? products[0];
const demoPrices = demo?.prices ?? [];
const categoryName = (slug: string) => CATEGORIES.find((c) => c.slug === slug)?.name ?? slug;
const usedCategories = new Set(products.map((p) => p.category));

const rules = [
  'Every required field is present',
  'Each tier price is the same or lower than the tier before it',
  'SKUs and slugs are unique and correctly formatted',
  'Category matches one of the 16 category slugs',
  'Fitment reads Make:Model:YYYY-YYYY or Universal',
  'No vehicle brand in the product name',
  'Short description under 160 characters; description 80–150 words, unique',
  'Pairs have pack_size 2; sets have 2 or more',
  'bought_with SKUs exist',
  'No emission-defeat terms (blocked-terms list)',
  'Kit components exist, share a vehicle, and the kit price is lower than the parts bought separately',
  'Sample rows are dropped from the production build',
];

const placeholders = [
  ['{LEGAL_NAME}', 'Legal company name'],
  ['{US_ADDRESS}', 'Registered US address'],
  ['{PHONE}', 'Phone number'],
  ['{SUPPORT_EMAIL}', 'Support email address'],
  ['{SUPPORT_HOURS}', 'Support hours'],
  ['{SHIPPING_WINDOW}', 'Confirmed delivery window (target 2–3 business days)'],
  ['{WHATSAPP_NUMBER}', 'WhatsApp Business number for orders'],
];
---
<BaseLayout
  title="Foundation Preview | BayStock Auto Parts"
  description="Phase 1 build preview: design tokens, typography, header, footer, and validated sample catalog."
  noindex
>
  <!-- Dark frame intro -->
  <section class="dark-frame relative overflow-hidden bg-ink-900 text-white">
    <div class="pointer-events-none absolute inset-0 opacity-[0.07]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 48px 48px;" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-40 -top-40 h-[480px] w-[480px] rounded-full bg-line-yellow/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-bay relative py-14 md:py-20">
      <p class="label-section text-line-yellow">Phase 1 of 6 · Foundation</p>
      <h1 class="mt-4 max-w-3xl text-5xl text-white md:text-7xl">Foundation preview</h1>
      <p class="mt-5 max-w-2xl text-lg text-on-dark-muted">
        Design tokens, fonts, header, footer, and the product file validator running on {products.length} sample products and {kits.length} sample kits. This page is temporary and is replaced by the home page in phase 2.
      </p>
      <dl class="mt-10 grid max-w-3xl grid-cols-2 gap-px overflow-hidden rounded border border-white/10 bg-white/10 sm:grid-cols-4">
        {[
          ['Products', String(products.length)],
          ['Kits', String(kits.length)],
          ['Categories used', `${usedCategories.size} / ${CATEGORIES.length}`],
          ['PAYMENT_MODE', PAYMENT_MODE],
        ].map(([k, v]) => (
          <div class="bg-ink-700 px-4 py-4">
            <dt class="label-section text-[0.6875rem] text-on-dark-muted">{k}</dt>
            <dd class="tag-mono mt-2 text-2xl text-white">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Vehicle bar (shown under the header once a vehicle is chosen; wired in phase 3) -->
  <div class="dark-frame border-b border-white/10 bg-ink-700 text-white">
    <div class="container-bay flex h-11 items-center gap-2 text-sm">
      <Icon name="car" size={18} class="text-line-yellow" />
      <span class="text-on-dark-muted">Shopping for:</span>
      <span class="font-semibold">2019 Toyota Camry</span>
      <span class="text-on-dark-muted">—</span>
      <button type="button" class="font-medium text-line-yellow underline underline-offset-4">change</button>
      <span class="label-section ml-auto hidden text-[0.6875rem] text-steel-500 sm:inline">Vehicle bar · example</span>
    </div>
  </div>

  <div class="container-bay space-y-16 py-14 md:space-y-24 md:py-20">

    <!-- Bin-tag cards -->
    <section aria-labelledby="cards">
      <p class="label-section text-text-600">Signature element</p>
      <h2 id="cards" class="mt-2 text-4xl">Bin-tag product cards</h2>
      <p class="mt-3 max-w-2xl text-text-600">SKU at the top, fitment under the name, and the four-tier price strip at the bottom. One sample product from each of the four sample categories.</p>
      <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        {showcase.map((p) => <ProductCard product={p} />)}
      </div>
    </section>

    <!-- Tier strip + bay line -->
    <section aria-labelledby="tiers" class="grid gap-10 lg:grid-cols-2">
      <div>
        <p class="label-section text-text-600">Signature element</p>
        <h2 id="tiers" class="mt-2 text-4xl">Tier strip</h2>
        <p class="mt-3 text-text-600">The active tier fills yellow. Shown here for <span class="tag-mono text-text-900">{demo?.sku}</span> at quantities 1, 3, 10, and 50. The live calculator arrives in phase 3.</p>
        <div class="mt-6 space-y-3 rounded-md border border-line-200 bg-surface-0 p-4">
          {[1, 3, 10, 50].map((q) => (
            <div class="grid grid-cols-[4.5rem_1fr] items-center gap-3">
              <span class="tag-mono text-sm text-text-600">Qty {q}</span>
              <TierStrip prices={demoPrices} qty={q} size="md" />
            </div>
          ))}
        </div>
      </div>
      <div>
        <p class="label-section text-text-600">Signature element</p>
        <h2 class="mt-2 text-4xl">Bay line</h2>
        <p class="mt-3 text-text-600">A thin yellow stripe with a hazard end cap. It sits under the header and becomes the cart's free-shipping progress bar.</p>
        <div class="mt-6 space-y-6 rounded-md border border-line-200 bg-surface-0 p-5">
          <BayLine />
          <div>
            <div class="flex items-baseline justify-between text-sm">
              <span>Add <span class="tag-mono">{usd(162.6)}</span> more for free shipping.</span>
              <span class="tag-mono text-text-600">{usd(87.4)} / {usd(RULES.freeShippingThreshold)}</span>
            </div>
            <div class="mt-2 h-2 overflow-hidden rounded-full bg-surface-50" aria-hidden="true">
              <div class="h-full rounded-full bg-line-yellow" style="width: 35%"></div>
            </div>
          </div>
          <div>
            <div class="flex items-baseline justify-between text-sm">
              <span class="font-semibold text-ok-green">Free shipping unlocked.</span>
              <span class="tag-mono text-text-600">{usd(268.1)}</span>
            </div>
            <div class="mt-2 h-2 overflow-hidden rounded-full bg-ok-green" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Colors -->
    <section aria-labelledby="colors">
      <p class="label-section text-text-600">Design tokens</p>
      <h2 id="colors" class="mt-2 text-4xl">Color</h2>
      <p class="mt-3 max-w-2xl text-text-600">Dark frame, light shelves, one accent. Yellow marks actions and savings only, and is never used as text on a light background.</p>
      <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {tokens.map((t) => (
          <li class="overflow-hidden rounded-md border border-line-200 bg-surface-0">
            <div class="h-20" style={`background:${t.hex}`}></div>
            <div class="p-3">
              <p class="tag-mono text-[0.8125rem]">{t.name}</p>
              <p class="tag-mono text-[0.75rem] text-text-600">{t.hex}</p>
              <p class="mt-1.5 text-[0.75rem] leading-snug text-text-600">{t.use}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Type -->
    <section aria-labelledby="type">
      <p class="label-section text-text-600">Design tokens</p>
      <h2 id="type" class="mt-2 text-4xl">Typography</h2>
      <div class="mt-8 grid gap-4 lg:grid-cols-3">
        <div class="rounded-md border border-line-200 bg-surface-0 p-6">
          <p class="label-section text-text-600">Headings · Barlow Condensed 600/700</p>
          <p class="mt-4 font-display text-5xl font-bold leading-none">Find parts that fit your vehicle</p>
          <p class="label-section mt-4 text-text-900">Uppercase for section labels only</p>
        </div>
        <div class="rounded-md border border-line-200 bg-surface-0 p-6">
          <p class="label-section text-text-600">Body · Inter 400/500</p>
          <p class="mt-4">Every listing shows the makes, models, and years it fits, plus the original part numbers it replaces.</p>
          <p class="mt-3 font-medium">16px base, 1.6 line height.</p>
        </div>
        <div class="rounded-md border border-line-200 bg-surface-0 p-6">
          <p class="label-section text-text-600">SKUs, prices, quantities · JetBrains Mono 500</p>
          <p class="tag-mono mt-4 text-2xl">BS-CAF-0012</p>
          <p class="tag-mono mt-1 text-2xl">$7.90 → $4.90</p>
          <p class="tag-mono mt-1 text-text-600">Qty 0010 · 1111 · 8888</p>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-3 rounded-md bg-ink-900 p-6 dark-frame">
        <a href="#" class="btn btn-primary">Primary action</a>
        <a href="#" class="btn btn-ghost-dark">Secondary on dark</a>
        <a href="#" class="link ml-2 text-line-yellow">Text link on dark</a>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-4 rounded-md border border-line-200 bg-surface-0 p-6">
        <a href="#" class="btn btn-primary">Add to cart</a>
        <a href="#" class="link">Text link on light</a>
        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-ok-green"><span class="h-2 w-2 rounded-full bg-ok-green"></span>In stock</span>
        <span class="text-sm font-medium text-alert-red">Out of stock. Message us for a restock date.</span>
      </div>
    </section>

    <!-- Catalog validation -->
    <section aria-labelledby="catalog">
      <p class="label-section text-text-600">Product file validator</p>
      <h2 id="catalog" class="mt-2 text-4xl">Sample catalog: {products.length} products, {kits.length} kits</h2>
      <p class="mt-3 max-w-3xl text-text-600">
        Read from <code class="tag-mono text-[0.875rem] text-text-900">data/products.csv</code> and <code class="tag-mono text-[0.875rem] text-text-900">data/kits.csv</code>. Every row is marked <code class="tag-mono text-[0.875rem] text-text-900">sample: true</code> and is excluded from the production build. Fitment, prices, and specs are placeholders, not supplier data.
      </p>

      <div class="mt-8 overflow-x-auto rounded-md border border-line-200 bg-surface-0">
        <table class="w-full min-w-[920px] text-left text-sm">
          <caption class="sr-only">Sample products with tier prices</caption>
          <thead class="bg-surface-50 text-text-600">
            <tr class="border-b border-line-200">
              <th scope="col" class="px-3 py-2.5 font-medium">SKU</th>
              <th scope="col" class="px-3 py-2.5 font-medium">Name</th>
              <th scope="col" class="px-3 py-2.5 font-medium">Category</th>
              <th scope="col" class="px-3 py-2.5 font-medium">Fits</th>
              <th scope="col" class="px-3 py-2.5 font-medium">Sold as</th>
              <th scope="col" class="px-3 py-2.5 text-right font-medium">1+</th>
              <th scope="col" class="px-3 py-2.5 text-right font-medium">3+</th>
              <th scope="col" class="px-3 py-2.5 text-right font-medium">10+</th>
              <th scope="col" class="px-3 py-2.5 text-right font-medium">50+</th>
              <th scope="col" class="px-3 py-2.5 text-right font-medium">lb</th>
            </tr>
          </thead>
          <tbody>
            {products.map((p) => (
              <tr class="border-b border-line-200 last:border-0 hover:bg-surface-50">
                <td class="tag-mono whitespace-nowrap px-3 py-2">{p.sku}</td>
                <td class="px-3 py-2">{p.name}</td>
                <td class="whitespace-nowrap px-3 py-2 text-text-600">{categoryName(p.category)}</td>
                <td class="px-3 py-2 text-text-600">{p.fitment.map(fitmentLabel).join('; ')}</td>
                <td class="whitespace-nowrap px-3 py-2 text-text-600">{soldAsLabel(p) ?? 'Each'}</td>
                {p.prices.map((t) => <td class="tag-mono px-3 py-2 text-right">{t.price.toFixed(2)}</td>)}
                <td class="tag-mono px-3 py-2 text-right text-text-600">{p.weightLb}</td>
              </tr>
            ))}
          </tbody>
          <tbody class="border-t-2 border-line-200">
            {kits.map((k) => (
              <tr class="border-b border-line-200 bg-[#fffbea] last:border-0">
                <td class="tag-mono whitespace-nowrap px-3 py-2">{k.sku}</td>
                <td class="px-3 py-2">{k.name} <span class="text-text-600">({k.components.map((c) => `${c.sku} ×${c.qty}`).join(' + ')})</span></td>
                <td class="px-3 py-2 text-text-600">Kit</td>
                <td class="px-3 py-2 text-text-600">{k.fitment.map(fitmentLabel).join('; ')}</td>
                <td class="whitespace-nowrap px-3 py-2 text-text-600">Save {usd(k.separatePrice - k.prices[0].price)}</td>
                {k.prices.map((t) => <td class="tag-mono px-3 py-2 text-right">{t.price.toFixed(2)}</td>)}
                <td class="tag-mono px-3 py-2 text-right text-text-600">{k.weightLb}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        <div class="rounded-md border border-line-200 bg-surface-0 p-6">
          <h3 class="text-2xl">What the build checks</h3>
          <p class="mt-1 text-sm text-text-600">A single bad row stops the build with the file, line, SKU, and reason.</p>
          <ul class="mt-4 space-y-2 text-sm">
            {rules.map((r) => (
              <li class="flex gap-2.5"><Icon name="shield" size={18} class="mt-0.5 shrink-0 text-ok-green" />{r}</li>
            ))}
          </ul>
        </div>
        <div class="dark-frame rounded-md bg-ink-900 p-6 text-white">
          <h3 class="text-2xl text-white">Example: a bad row</h3>
          <p class="mt-1 text-sm text-on-dark-muted">Output of <code class="tag-mono">npm run build</code> when price_10 is set above price_3:</p>
          <pre class="tag-mono mt-4 overflow-x-auto whitespace-pre-wrap rounded bg-ink-700 p-4 text-[0.8125rem] leading-relaxed text-on-dark-muted"><span class="text-white">Catalog validation failed with 1 error(s):</span>
  <span class="text-[#ff8a80]">✗</span> products.csv line 2 (BS-CAF-0012): price_10 (7.00) is higher than price_3 (6.90); each tier must be the same or lower than the one before

Fix data/products.csv or data/kits.csv and run the build again.</pre>
        </div>
      </div>
    </section>

    <!-- Shared config -->
    <section aria-labelledby="config" class="grid gap-4 lg:grid-cols-2">
      <div class="rounded-md border border-line-200 bg-surface-0 p-6">
        <p class="label-section text-text-600">Shared config</p>
        <h2 id="config" class="mt-2 text-3xl">Business rules</h2>
        <dl class="mt-4 divide-y divide-line-200 text-sm">
          {[
            ['Price tiers', RULES.tiers.map((t) => `${t}+`).join(' · ')],
            ['Minimum order', 'None'],
            ['Free ground shipping', `Orders of ${usd(RULES.freeShippingThreshold)} or more`],
            ['Shipping below threshold', `By weight, from ${usd(RULES.shippingFrom)}`],
            ['Ships to', RULES.shipsTo],
            ['Warranty', `${RULES.warrantyMonths} months (to be confirmed by owner)`],
            ['Returns', `${RULES.returnDays} days (to be confirmed by owner)`],
            ['Delivery window', SITE.shippingWindow],
            ['Payment mode', PAYMENT_MODE],
          ].map(([k, v]) => (
            <div class="flex justify-between gap-4 py-2.5"><dt class="text-text-600">{k}</dt><dd class="tag-mono text-right">{v}</dd></div>
          ))}
        </dl>
        <h3 class="mt-6 text-xl">Shipping rates <span class="font-sans text-sm font-normal text-text-600">(data/shipping-rates.json, only $9 confirmed)</span></h3>
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">Shipping rates by order weight</caption>
          <tbody class="divide-y divide-line-200">
            {SHIPPING_RATES.map((r, i) => (
              <tr>
                <th scope="row" class="py-2 text-left font-normal text-text-600">
                  {r.max_lb === null ? `Over ${SHIPPING_RATES[i - 1].max_lb} lb` : i === 0 ? `Up to ${r.max_lb} lb` : `Over ${SHIPPING_RATES[i - 1].max_lb} lb, up to ${r.max_lb} lb`}
                </th>
                <td class="tag-mono py-2 text-right">{usd(r.price)}</td>
              </tr>
            ))}
            <tr><th scope="row" class="py-2 text-left font-normal text-text-600">Any weight, subtotal $250 or more</th><td class="py-2 text-right font-semibold text-ok-green">Free</td></tr>
          </tbody>
        </table>
      </div>
      <div class="rounded-md border border-line-200 bg-surface-0 p-6">
        <p class="label-section text-text-600">Open items</p>
        <h2 class="mt-2 text-3xl">Placeholders waiting for real values</h2>
        <p class="mt-2 text-sm text-text-600">These stay in curly braces on every page until you supply them. The launch checklist fails while any remain.</p>
        <ul class="mt-4 divide-y divide-line-200 text-sm">
          {placeholders.map(([k, v]) => (
            <li class="flex justify-between gap-4 py-2.5"><code class="tag-mono">{k}</code><span class="text-right text-text-600">{v}</span></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
