---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryTile from '../components/CategoryTile.astro';
import TierStrip from '../components/TierStrip.astro';
import FaqList from '../components/FaqList.astro';
import PartImage from '../components/PartImage.astro';
import VehicleSelector from '../islands/VehicleSelector';
import { CATEGORIES, usd } from '../config/site';
import { REASONS, FACT_STRIP, FAQ } from '../content/copy';
import { products, kits, vehicles, productsForVehicle, kitsForVehicle, productUrl, primaryFitment } from '../lib/catalog';
import { getPosts, postUrl, fmtDate } from '../lib/blog';

// Launch vehicles first (spec section 4), then any other model in the product file.
const LAUNCH = ['Toyota Camry', 'Toyota Corolla', 'Toyota RAV4', 'Toyota Tacoma', 'Honda Civic', 'Honda Accord', 'Honda CR-V', 'Nissan Altima', 'Nissan Sentra', 'Nissan Rogue', 'Ford F-150', 'Chevrolet Silverado 1500', 'Ram 1500'];
const vehicleGrid = [
  ...LAUNCH.map((n) => vehicles.find((v) => `${v.make} ${v.model}` === n)).filter((v): v is NonNullable<typeof v> => !!v),
  ...vehicles.filter((v) => !LAUNCH.includes(`${v.make} ${v.model}`)),
].map((v) => ({ ...v, count: productsForVehicle(v.make, v.model).length + kitsForVehicle(v.make, v.model).length }));

const homeKits = kits.slice(0, 4);
const example = products.find((p) => p.caseQty && p.soldAs === 'each') ?? products[0];
const posts = (await getPosts()).slice(0, 3);
const reasonIcon: Record<string, string> = { factory: 'factory', check: 'check', car: 'car', shield: 'shield', truck: 'truck', tag: 'tag', chat: 'chat' };
---
<BaseLayout
  title="Auto Parts at Wholesale Prices | BayStock Auto Parts"
  description="Factory-direct auto parts for car owners and repair shops. Filters, ignition, sensors, and brake pads with volume discounts. Free shipping over $250."
>
  <!-- Hero -->
  <section class="dark-frame relative overflow-hidden bg-ink-900 text-white">
    <PartImage path="hero" set="site" alt="" class="pointer-events-none absolute inset-0 h-full w-full opacity-40 [&_img]:object-cover" eager optional />
    <div class="pointer-events-none absolute inset-0 opacity-[0.06]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 56px 56px;" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-48 -top-48 h-[560px] w-[560px] rounded-full bg-line-yellow/[0.12] blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute bottom-0 left-0 h-2 w-full" style="background: var(--hazard); opacity: .9" aria-hidden="true"></div>

    <div class="container-bay relative grid gap-10 py-12 md:py-20 lg:grid-cols-12 lg:items-center lg:gap-12 lg:py-24">
      <div class="lg:col-span-7">
        <p class="label-section text-line-yellow">Factory-direct auto parts · Ships from the US</p>
        <h1 class="mt-4 text-[2.75rem] leading-[0.98] text-white sm:text-6xl lg:text-[4.5rem]">Auto parts at shop prices, for one car or a full shelf</h1>
        <p class="mt-6 max-w-xl text-lg text-on-dark-muted md:text-xl">
          Filters, coils, sensors, pads, and service kits, bought direct from the manufacturers. Buy one for your own car, or stock up and pay less per unit at 3, 10, and 50. Free ground shipping on orders over $250.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <button type="button" class="btn btn-primary h-14 px-6 text-base" data-vehicle-open>
            <Icon name="car" size={22} />
            Find parts for my vehicle
          </button>
          <a href="/wholesale/" class="btn btn-ghost-dark h-14 px-6 text-base">See how pricing works</a>
        </div>
      </div>

      <div class="hero-slide lg:col-span-5">
        <div class="rounded-lg border border-white/10 bg-ink-700/90 p-5 shadow-2xl backdrop-blur md:p-6">
          <p class="label-section text-line-yellow">Shop by vehicle</p>
          <p class="mt-2 font-display text-3xl font-bold leading-none text-white">What are you working on?</p>
          <div class="mt-5 [&_select]:border-transparent">
            <VehicleSelector client:load vehicles={vehicles} variant="hero" />
          </div>
          {example && (
            <div class="mt-6 border-t border-white/10 pt-5">
              <div class="flex items-baseline justify-between gap-3">
                <p class="text-sm text-on-dark-muted">Live tier price · <span class="tag-mono text-white">{example.sku}</span></p>
                <a href={productUrl(example)} class="text-sm text-line-yellow underline underline-offset-4">View</a>
              </div>
              <div class="mt-2.5"><TierStrip prices={example.prices} qty={10} size="md" /></div>
              <p class="mt-2 text-[0.8125rem] text-on-dark-muted">{example.name} — fits {primaryFitment(example)}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 1. Fact strip -->
  <section aria-label="Key facts" class="border-b border-line-200 bg-surface-0">
    <ul class="container-bay grid grid-cols-2 divide-line-200 md:grid-cols-4 md:divide-x">
      {FACT_STRIP.map((f, i) => (
        <li class="flex items-center gap-3 py-4 md:justify-center md:py-5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded bg-line-yellow text-ink-900">
            <Icon name={(['factory', 'truck', 'shield', 'tag'] as const)[i]} size={20} />
          </span>
          <span class="text-[0.9375rem] font-semibold leading-tight">{f}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- 2. Shop by vehicle -->
  <section class="container-bay py-14 md:py-20" aria-labelledby="h-vehicles">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHead label="Shop by vehicle" title="Find parts that fit your vehicle" id="h-vehicles" />
      <a href="/vehicles/" class="link text-sm">All vehicles</a>
    </div>
    <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {vehicleGrid.map((v) => (
        <li>
          <a href={`/vehicles/${v.makeSlug}/${v.modelSlug}/`} class="bin-card group flex h-full items-center justify-between gap-2 px-4 py-4 no-underline">
            <span>
              <span class="block text-[0.75rem] text-text-600">{v.make}</span>
              <span class="block font-display text-2xl font-bold leading-none">{v.model}</span>
              <span class="tag-mono mt-1.5 block text-[0.6875rem] text-text-600">{Math.min(...v.years)}–{Math.max(...v.years)} · {v.count} parts</span>
            </span>
            <Icon name="arrow" size={18} class="shrink-0 text-text-600 transition-transform group-hover:translate-x-0.5" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 3. Shop by category -->
  <section class="border-y border-line-200 bg-surface-0 py-14 md:py-20" aria-labelledby="h-categories">
    <div class="container-bay">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHead label="Shop by category" title="Shop by category" id="h-categories" />
        <a href="/parts/" class="link text-sm">All categories</a>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-8 [&>a]:bg-surface-50">
        {CATEGORIES.map((c) => <CategoryTile slug={c.slug} name={c.name} />)}
      </div>
    </div>
  </section>

  <!-- 4. Why BayStock -->
  <section class="dark-frame bg-ink-900 py-14 text-white md:py-20" aria-labelledby="h-why">
    <div class="container-bay">
      <SectionHead label="Why BayStock" title="Why buy from BayStock" id="h-why" dark />
      <ul class="mt-10 grid gap-px overflow-hidden rounded-lg border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
        {REASONS.map((r) => (
          <li class="bg-ink-900 p-6 md:p-7">
            <span class="flex h-10 w-10 items-center justify-center rounded border border-line-yellow/40 text-line-yellow">
              <Icon name={reasonIcon[r.icon] as any} size={22} />
            </span>
            <h3 class="mt-4 text-2xl text-white">{r.title}</h3>
            <p class="mt-2 text-on-dark-muted">{r.copy}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. Service kits -->
  {homeKits.length > 0 && (
    <section class="container-bay py-14 md:py-20" aria-labelledby="h-kits">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <SectionHead label="Service kits" title="Everything for the job in one kit" id="h-kits" class="lg:col-span-7">
          <p class="mt-4 max-w-2xl text-lg text-text-600">Kits group the parts that are replaced together, such as the oil, engine air, and cabin filters for one vehicle, at a lower price than buying them separately.</p>
        </SectionHead>
        <div class="lg:col-span-5 lg:text-right"><a href="/kits/" class="btn border border-text-900 bg-surface-0 no-underline">See all kits</a></div>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        {homeKits.map((k) => <ProductCard kit={k} />)}
      </div>
    </section>
  )}

  <!-- 6. How pricing works -->
  <section class="border-y border-line-200 bg-surface-0 py-14 md:py-20" aria-labelledby="h-pricing">
    <div class="container-bay grid gap-10 lg:grid-cols-12 lg:items-center">
      <SectionHead label="How pricing works" title="The more you buy, the less each part costs" id="h-pricing" class="lg:col-span-6">
        <p class="mt-4 max-w-xl text-lg text-text-600">Every part has four prices. Buy 1 or 2 at the shop price, then pay less per unit at 3, at 10, and at 50. The price updates as you change the quantity, so you always see what you will pay before you add to cart.</p>
        <a href="/wholesale/" class="link mt-5 inline-block">How BayStock pricing works</a>
      </SectionHead>
      {example && (
        <div class="lg:col-span-6">
          <div class="rounded-lg border border-line-200 bg-surface-50 p-5 md:p-6" data-buy data-sku={example.sku} data-prices={JSON.stringify(example.prices)} data-instock={String(example.inStock)}>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="tag-mono text-[0.75rem] text-text-600">{example.sku}</p>
                <a href={productUrl(example)} class="font-semibold no-underline hover:underline">{example.name}</a>
                <p class="text-[0.8125rem] text-text-600">Fits {primaryFitment(example)}</p>
              </div>
              <p class="text-right">
                <span class="block text-[0.75rem] text-text-600">Unit price</span>
                <span class="tag-mono text-3xl" data-unit-price>{usd(example.prices[0].price)}</span>
              </p>
            </div>
            <div class="mt-4"><TierStrip prices={example.prices} size="md" interactive /></div>
            <div class="mt-4 flex items-center gap-3">
              <div class="flex items-center rounded border border-line-200 bg-surface-0">
                <button type="button" data-dec class="h-11 w-11 text-lg" aria-label="Decrease quantity">−</button>
                <label for="demo-qty" class="sr-only">Quantity</label>
                <input id="demo-qty" data-qty type="number" min="1" max="9999" value="1" class="tag-mono h-11 w-16 border-x border-line-200 text-center [appearance:textfield]" />
                <button type="button" data-inc class="h-11 w-11 text-lg" aria-label="Increase quantity">+</button>
              </div>
              <p class="ml-auto text-right"><span class="block text-[0.75rem] text-text-600">Line total</span><span class="tag-mono text-lg" data-line-total>{usd(example.prices[0].price)}</span></p>
            </div>
            <p data-nudge class="mt-3 text-sm font-medium"></p>
            <p data-qty-error hidden class="mt-2 text-sm text-alert-red"></p>
            <button type="button" data-add class="btn btn-primary mt-4 w-full"><span data-add-label>Add to cart</span></button>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 7. How ordering works -->
  <section class="container-bay py-14 md:py-20" aria-labelledby="h-steps">
    <SectionHead label="How ordering works" title="Order in three steps" id="h-steps" />
    <ol class="mt-10 grid gap-4 md:grid-cols-3">
      {['Add your parts to the cart.', 'Place your order. You are not charged on the site.', 'We confirm on WhatsApp and send payment instructions, then ship from our US warehouse.'].map((s, i) => (
        <li class="relative overflow-hidden rounded-lg border border-line-200 bg-surface-0 p-6">
          <span class="tag-mono absolute -right-2 -top-6 text-[7rem] leading-none text-surface-50" aria-hidden="true">{i + 1}</span>
          <span class="relative flex h-10 w-10 items-center justify-center rounded bg-ink-900 font-display text-xl font-bold text-line-yellow">{i + 1}</span>
          <p class="relative mt-4 text-lg font-medium leading-snug">{s}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 8. For repair shops -->
  <section class="container-bay pb-14 md:pb-20" aria-labelledby="h-shops">
    <div class="dark-frame relative overflow-hidden rounded-lg bg-ink-900 p-7 text-white md:p-12">
      <div class="pointer-events-none absolute inset-y-0 right-0 w-24 opacity-90 md:w-40" style="background: var(--hazard)" aria-hidden="true"></div>
      <div class="relative max-w-2xl">
        <p class="label-section text-line-yellow">For repair shops</p>
        <h2 id="h-shops" class="mt-2 text-4xl text-white md:text-5xl">Stocking a shop?</h2>
        <p class="mt-4 text-lg text-on-dark-muted">Type or paste part numbers and quantities and add them all to the cart at once. Orders over $250 ship free.</p>
        <a href="/quick-order/" class="btn btn-primary mt-6 h-14 px-6 text-base no-underline"><Icon name="list" size={20} />Open quick order</a>
      </div>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="border-t border-line-200 bg-surface-0 py-14 md:py-20" aria-labelledby="h-faq">
    <div class="container-bay grid gap-8 lg:grid-cols-12">
      <SectionHead label="FAQ" title="Common questions" id="h-faq" class="lg:col-span-4">
        <a href="/faq/" class="link mt-4 inline-block">All questions</a>
      </SectionHead>
      <div class="lg:col-span-8"><FaqList items={FAQ.slice(0, 5)} /></div>
    </div>
  </section>

  <!-- 10. From the blog -->
  {posts.length > 0 && (
    <section class="container-bay py-14 md:py-20" aria-labelledby="h-blog">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHead label="From the blog" title="Shop notes" id="h-blog" />
        <a href="/blog/" class="link text-sm">All articles</a>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {posts.map((p) => (
          <a href={postUrl(p)} class="bin-card group flex flex-col overflow-hidden no-underline">
            <div class="dark-frame relative aspect-[16/9] overflow-hidden bg-ink-900">
              <PartImage path={p.data.cover ?? p.id} set="blog" alt="" class="h-full w-full [&_img]:object-cover" plain icon="toolbox" />
              <div class="absolute bottom-0 left-0 h-1 w-full bg-line-yellow"></div>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <p class="tag-mono text-[0.75rem] text-text-600">{fmtDate(p.data.updated)}</p>
              <h3 class="mt-2 text-2xl leading-tight group-hover:underline">{p.data.title}</h3>
              <p class="mt-2 text-sm text-text-600">{p.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
