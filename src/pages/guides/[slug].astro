---
import GuidePage from '../../views/GuidePage.astro';
import { published } from '../../lib/content';
import { slugOf } from '../../i18n/routes';
export async function getStaticPaths() {
  return (await published('guides', 'fr')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<GuidePage {entry} />
