---
import V from '../../views/SectorPage.astro';
import { published } from '../../lib/content';
import { slugOf } from '../../i18n/routes';
export async function getStaticPaths() {
  return (await published('secteurs', 'fr')).map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<V {entry} />
