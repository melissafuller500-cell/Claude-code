---
/** Gabarit des guides (section 7) : En bref, sommaire ancré, texte, démonstration, outils, glossaire, sources, avertissement. */
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Toc from '../components/Toc.astro';
import CtaBox from '../components/CtaBox.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Sources from '../components/Sources.astro';
import AgingDemo from '../components/AgingDemo.astro';
import CopyScript from '../components/CopyScript.astro';
import { PAGES } from '../data/pages';
import { crumbs } from '../lib/crumbs';
import { article } from '../lib/schema';
import { ogFor } from '../lib/og';
import { alternatesFor, published, findByKey, readingTime } from '../lib/content';
import { useUI, fmtDate } from '../i18n/ui';
import { ROUTES, entryUrl, langOf } from '../i18n/routes';

interface Props { entry: CollectionEntry<'guides'> }
const { entry } = Astro.props;
const lang = langOf(entry.id);
const t = useUI(lang);
const d = entry.data;
const { Content, headings } = await render(entry);
const path = entryUrl('guides', entry.id);
const alternates = await alternatesFor('guides', entry);
const gloss = await published('glossaire', lang);
const terms = d.glossary.map((k) => findByKey(gloss, k, lang)).filter(Boolean) as CollectionEntry<'glossaire'>[];
const toolKeys = d.tools;
const hasTemplate = (entry.body ?? '').includes('```modele');
const en = lang === 'en';
---
<Base stem {lang} title={d.title} description={d.description} {path} {alternates} ogType="article" published={d.pubDate} modified={d.updatedDate}
  crumbs={crumbs(lang, ['guides'], [{ name: d.title, url: path }])} section="ressources"
  jsonLd={[article({ type: 'Article', title: d.title, description: d.description, url: path, image: ogFor(path), lang, published: d.pubDate, modified: d.updatedDate })]}>
  <PageHead title={d.title} answer={d.answer} answerLabel={t.inBrief}>
    <p slot="meta" class="small">
      {t.by} <a class="link" href={ROUTES.apropos[lang]}>Noé Mbwang</a> ·
      {t.published} <time datetime={d.pubDate.toISOString().slice(0, 10)}>{fmtDate(d.pubDate, lang)}</time>
      {d.updatedDate && <> · {t.updated} <time datetime={d.updatedDate.toISOString().slice(0, 10)}>{fmtDate(d.updatedDate, lang)}</time></>}
      · {t.readingTime(readingTime(entry.body))}
    </p>
    <Toc {headings} {lang} />
  </PageHead>
  <div class="wrap">
    <div class="prose"><Content /></div>
    {d.demo === 'balance-agee' && <AgingDemo {lang} />}
    <nav class="links" aria-labelledby="tools-h">
      <h2 id="tools-h">{en ? 'Tools for this guide' : 'Les outils de ce guide'}</h2>
      <ul>{toolKeys.map((k) => <li><a class="arrow-link" href={ROUTES[k][lang]}>{PAGES[k][lang].title}</a></li>)}</ul>
      {terms.length > 0 && (
        <>
          <h2>{en ? 'Glossary' : 'Glossaire'}</h2>
          <ul>{terms.map((g) => <li><a class="arrow-link" href={entryUrl('glossaire', g.id)}>{g.data.term}</a></li>)}</ul>
        </>
      )}
    </nav>
    <CtaBox {lang} src="guide" />
    <Sources {lang} items={d.sources} />
    <p class="disclaimer">{t.disclaimer}</p>
    <AuthorBox {lang} />
  </div>
  {hasTemplate && <CopyScript />}
</Base>
<style>
  .links { margin-top: 48px; display: grid; gap: 6px; }
  .links h2 { font-size: 22px; margin-top: 14px; }
  .links ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0 26px; }
  .disclaimer { margin-top: 24px; }
  .wrap { padding-bottom: 48px; }
</style>
