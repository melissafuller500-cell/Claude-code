---
/** Gabarit d'article (section 8.2). */
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CtaBox from '../components/CtaBox.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Sources from '../components/Sources.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CopyScript from '../components/CopyScript.astro';
import { PAGES } from '../data/pages';
import { CATEGORIES } from '../data/editorial';
import { crumbs } from '../lib/crumbs';
import { article } from '../lib/schema';
import { ogFor } from '../lib/og';
import { alternatesFor, published, findByKey, readingTime, byDateDesc } from '../lib/content';
import { useUI, fmtDate } from '../i18n/ui';
import { ROUTES, BLOG_CATEGORY_BASE, entryUrl, langOf } from '../i18n/routes';

interface Props { entry: CollectionEntry<'blog'> }
const { entry } = Astro.props;
const lang = langOf(entry.id);
const t = useUI(lang);
const d = entry.data;
const { Content } = await render(entry);
const path = entryUrl('blog', entry.id);
const alternates = await alternatesFor('blog', entry);
const cat = CATEGORIES[d.category][lang];
const posts = (await published('blog', lang)).filter((p) => p.id !== entry.id).sort(byDateDesc);
const related = [...posts.filter((p) => p.data.category === d.category), ...posts.filter((p) => p.data.category !== d.category)].slice(0, 3);
const guides = await published('guides', lang);
const guide = d.guide ? findByKey(guides, d.guide, lang) : undefined;
const legal = !['tresorerie', 'suivi'].includes(d.category);
const hasTemplate = (entry.body ?? '').includes('```modele');
const iso = (x: Date) => x.toISOString().slice(0, 10);
---
<Base {lang} title={d.title} description={d.description} {path} {alternates} ogType="article" published={d.pubDate} modified={d.updatedDate}
  crumbs={crumbs(lang, ['blog'], [{ name: cat.name, url: `${BLOG_CATEGORY_BASE[lang]}${cat.slug}/` }, { name: d.title, url: path }])} section="blog"
  jsonLd={[article({ type: 'BlogPosting', title: d.title, description: d.description, url: path, image: ogFor(path), lang, published: d.pubDate, modified: d.updatedDate })]}>
  <article class="wrap post">
    <header class="ph">
      <p class="eyebrow"><a href={`${BLOG_CATEGORY_BASE[lang]}${cat.slug}/`}>{cat.name}</a></p>
      <h1>{d.title}</h1>
      <p class="small">
        {t.by} <a class="link" href={ROUTES.apropos[lang]}>Noé Mbwang</a> ·
        {t.published} <time datetime={iso(d.pubDate)}>{fmtDate(d.pubDate, lang)}</time>
        {d.updatedDate && <> · {t.updated} <time datetime={iso(d.updatedDate)}>{fmtDate(d.updatedDate, lang)}</time></>}
        · {t.readingTime(readingTime(entry.body))}
      </p>
      <div class="callout"><b>{t.shortAnswer}</b><p class="ans">{d.answer}</p></div>
    </header>
    <div class="prose"><Content /></div>
    <CtaBox {lang} src="article" />
    <Sources {lang} items={d.sources} />
    {legal && <p class="disclaimer">{t.disclaimer}</p>}
    <AuthorBox {lang} />
    <nav aria-labelledby="related-h" class="related">
      <h2 id="related-h">{t.related}</h2>
      <p class="next">
        {d.tool && <a class="arrow-link" href={ROUTES[d.tool][lang]}>{t.toolLink} : {PAGES[d.tool][lang].title}</a>}
        {guide && <a class="arrow-link" href={entryUrl('guides', guide.id)}>{t.guideLink} : {guide.data.title}</a>}
      </p>
      {related.length > 0 && <div class="cards">{related.map((p) => <ArticleCard post={p} level="h3" />)}</div>}
    </nav>
  </article>
  {hasTemplate && <CopyScript />}
</Base>
<style>
  .post { padding-bottom: 64px; }
  .ph { display: grid; gap: 18px; padding-block: clamp(20px, 3vw, 40px) 28px; max-width: 820px; }
  .eyebrow a { color: inherit; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .ph h1 { font-size: clamp(34px, 5vw, 58px); }
  .ans { font-size: 18px; }
  .related { margin-top: 40px; display: grid; gap: 16px; }
  .related h2 { font-size: 26px; }
  .next { display: flex; flex-wrap: wrap; gap: 0 26px; }
</style>
