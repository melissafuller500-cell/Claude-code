---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import BayLine from './BayLine.astro';
import SearchBox from '../islands/SearchBox';
import { usd } from '../config/site';

const nav = [
  { href: '/parts/', label: 'All parts' },
  { href: '/kits/', label: 'Service kits' },
  { href: '/vehicles/', label: 'Vehicles' },
  { href: '/wholesale/', label: 'How pricing works' },
  { href: '/shipping/', label: 'Shipping' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="dark-frame sticky top-0 z-40 bg-ink-900 text-white" data-site-header>
  <div class="container-bay flex h-16 items-center gap-3 lg:h-[72px] lg:gap-6">
    <button type="button" class="-ml-2 inline-flex h-11 w-11 items-center justify-center rounded text-white lg:hidden" aria-controls="mobile-nav" aria-expanded="false" data-nav-toggle>
      <span class="sr-only" data-nav-label>Open menu</span>
      <Icon name="menu" size={24} class="nav-icon-open" />
      <Icon name="close" size={24} class="nav-icon-close hidden" />
    </button>

    <Logo />

    <div class="hidden flex-1 md:block">
      <SearchBox client:idle id="site-search" placeholder="Part name, SKU, OE number, or vehicle" />
    </div>

    <button type="button" class="hidden h-11 max-w-[220px] items-center gap-2 rounded border border-steel-500/70 px-3.5 text-sm font-medium text-white transition-colors hover:border-white md:inline-flex" data-vehicle-open>
      <Icon name="car" size={20} class="shrink-0 text-line-yellow" />
      <span class="truncate" data-vehicle-button-label data-default="Select vehicle">Select vehicle</span>
    </button>

    <a href="/quick-order/" class="hidden h-11 items-center gap-2 px-1 text-sm font-medium text-white no-underline hover:text-line-yellow xl:inline-flex">
      <Icon name="list" size={20} />
      Quick order
    </a>

    <a href="/cart/" class="relative ml-auto inline-flex h-11 items-center gap-2.5 rounded bg-line-yellow pl-3 pr-3.5 text-ink-900 no-underline shadow-[inset_0_-3px_0_rgb(0_0_0/0.18)] transition-colors hover:bg-[#ffd23f] md:ml-0" aria-label="Cart" data-cart-link>
      <Icon name="cart" size={20} />
      <span class="tag-mono text-[0.9375rem]" data-cart-total>{usd(0)}</span>
      <span data-cart-count hidden class="tag-mono absolute -right-2 -top-2 flex h-5 min-w-5 items-center justify-center rounded-full bg-white px-1 text-[0.6875rem] text-ink-900 ring-2 ring-ink-900">0</span>
    </a>
  </div>

  <div class="container-bay flex gap-2 pb-3 md:hidden">
    <div class="flex-1">
      <SearchBox client:idle id="site-search-m" placeholder="Part, SKU, or OE number" />
    </div>
    <button type="button" class="inline-flex h-11 max-w-[42%] items-center gap-1.5 rounded border border-steel-500/70 px-3 text-sm font-medium" data-vehicle-open>
      <Icon name="car" size={20} class="shrink-0 text-line-yellow" />
      <span class="truncate" data-vehicle-button-label data-default="Vehicle">Vehicle</span>
    </button>
  </div>

  <nav aria-label="Main" class="hidden border-t border-white/[0.07] bg-ink-900 lg:block">
    <ul class="container-bay flex h-10 items-center gap-7 text-[0.875rem]">
      {nav.map((item) => (
        <li>
          <a href={item.href}
            class:list={['no-underline transition-colors hover:text-white', path.startsWith(item.href) ? 'text-white' : 'text-on-dark-muted']}
            aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
      <li class="xl:hidden"><a href="/quick-order/" class="text-on-dark-muted no-underline hover:text-white">Quick order</a></li>
      <li class="tag-mono ml-auto text-[0.75rem] tracking-wide text-on-dark-muted">Free ground shipping over $250 · No minimum order</li>
    </ul>
  </nav>

  <BayLine />

  <!-- Vehicle bar: shown under the header once a vehicle is chosen -->
  <div class="border-b border-white/10 bg-ink-700" data-vehicle-bar hidden>
    <div class="container-bay flex h-10 items-center gap-2 text-sm">
      <Icon name="car" size={18} class="shrink-0 text-line-yellow" />
      <span class="hidden text-on-dark-muted sm:inline">Shopping for:</span>
      <span class="truncate font-semibold" data-vehicle-label></span>
      <span class="text-on-dark-muted">—</span>
      <button type="button" class="font-medium text-line-yellow underline underline-offset-4" data-vehicle-open>change</button>
      <button type="button" class="ml-auto text-[0.8125rem] text-on-dark-muted underline underline-offset-4 hover:text-white" data-vehicle-clear>Clear</button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Mobile" class="hidden max-h-[calc(100dvh-8rem)] overflow-y-auto border-t border-white/10 bg-ink-900 lg:hidden" data-nav-panel>
    <ul class="container-bay flex flex-col py-2">
      {[...nav, { href: '/quick-order/', label: 'Quick order' }, { href: '/faq/', label: 'FAQ' }, { href: '/about/', label: 'About' }].map((item) => (
        <li>
          <a href={item.href} class="flex h-12 items-center justify-between border-b border-white/[0.07] text-base no-underline">
            {item.label}
            <Icon name="chevron" size={18} class="text-steel-500" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
