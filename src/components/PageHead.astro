---
/** En-tête de page secondaire : h1, réponse autonome de 40 à 60 mots (AEO), dates éventuelles. */
interface Props { title: string; eyebrow?: string; answer?: string; answerLabel?: string; lead?: string }
const { title, eyebrow, answer, answerLabel, lead } = Astro.props;
---
<header class="ph wrap">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  <slot name="meta" />
  {answer && (
    <div class="callout answer">
      {answerLabel && <b>{answerLabel}</b>}
      <p>{answer}</p>
    </div>
  )}
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>
<style>
  .ph { display: grid; gap: 20px; padding-block: clamp(24px, 4vw, 48px) clamp(32px, 4vw, 56px); max-width: 980px; margin-inline: 0; }
  @media (min-width: 1240px) { .ph { margin-inline: auto; max-width: var(--maxw); } .ph > * { max-width: 860px; } }
  .answer p { font-size: 18px; line-height: 1.55; }
</style>
