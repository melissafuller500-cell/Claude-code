---
/**
 * Scène du hero : disque de marque, portrait détouré, mot « NOÉ » en filigrane, cartes d'exemple
 * (relance, facture) et feuilles. Tout le décor est aria-hidden ; le portrait garde son texte alternatif.
 * L'animation (flux de particules, cartes qui changent d'état, parallaxe) vit dans scripts/hero.ts.
 */
import { Picture } from 'astro:assets';
import { brand } from '../lib/brand';
import Logo from './Logo.astro';
import type { Lang } from '../i18n/routes';
interface Props { alt: string; lang: Lang }
const { alt, lang } = Astro.props;
const en = lang === 'en';
const leaf = '<path d="M0 12C8 0 26-2 40 12 26 26 8 24 0 12Z"/>';
---
<div class="stage" data-stage>
  <div class="plane disc" data-d="0.3" aria-hidden="true"></div>
  <div class="plane ring" data-d="0.45" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none"><circle cx="52" cy="50" r="47" stroke="rgba(90,180,255,.35)" stroke-width=".35" stroke-dasharray="1 2.4" /><path d="M90 30h6M93 30v-6M8 72H3M5 72v6" stroke="rgba(90,180,255,.5)" stroke-width=".4" /><circle cx="96" cy="24" r=".9" fill="#5AB4FF" /><circle cx="3" cy="78" r=".9" fill="#5AB4FF" /></svg>
  </div>
  <div class="plane word" data-d="0.6" aria-hidden="true">NOÉ</div>
  <div class="plane face" data-d="1">
    {brand.cutout ? (
      <Picture src={brand.cutout} alt={alt} widths={[360, 520, 720]} sizes="(max-width: 900px) 78vw, 520px" formats={['avif', 'webp']} quality={60} loading="eager" fetchpriority="high" class="cut" />
    ) : (
      <div class="ph" aria-hidden="true"><Logo size={120} /></div>
    )}
  </div>
  <div class="plane chip c2" data-d="1.9" aria-hidden="true">
    <div class="row"><b data-chip="r-title">{en ? 'D+7 reminder' : 'Relance J+7'}</b><span class="pill blue" data-chip="r-state">{en ? 'sent' : 'envoyée'}</span></div>
    <span class="meta" data-chip="r-meta">{en ? 'WhatsApp · on schedule' : 'WhatsApp · à date fixe'}</span>
  </div>
  <div class="plane chip c1" data-d="2.4" aria-hidden="true">
    <div class="row"><b data-chip="i-title">{en ? 'Invoice F-1042' : 'Facture F-1042'}</b><span class="pill" data-chip="i-state">{en ? 'paid' : 'payée'}</span></div>
    <div class="row"><span class="meta">{en ? 'Due D+30 · example' : 'Échéance J+30 · exemple'}</span><span class="meta num" data-chip="i-amount">4 200 000 FCFA</span></div>
  </div>
  <div class="plane leafx l1" data-d="3.2" aria-hidden="true"><svg viewBox="0 0 40 24" set:html={leaf} /></div>
  <div class="plane leafx l2" data-d="2.6" aria-hidden="true"><svg viewBox="0 0 40 24" set:html={leaf} /></div>
  <div class="plane leafx l3" data-d="0.2" aria-hidden="true"><svg viewBox="0 0 40 24" set:html={leaf} /></div>
</div>
<style>
  .stage { position: relative; aspect-ratio: 4 / 4.6; width: 100%; max-width: 560px; justify-self: end; }
  .plane { position: absolute; will-change: transform; transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .disc { inset: 9% 2% 9% 6%; border-radius: 50%; background: radial-gradient(circle at 34% 28%, #9dbb86 0%, #6f9562 38%, #3e6236 78%, #2b4a27 100%); box-shadow: inset -30px -40px 80px rgba(6, 17, 11, 0.45), 0 40px 80px -30px rgba(0, 0, 0, 0.7); }
  .disc::after { content: ''; position: absolute; inset: -14px; border-radius: 50%; border: 1px dashed rgba(163, 214, 92, 0.28); }
  .disc:global(.pulse) { animation: pulse 0.7s ease-out; }
  @keyframes pulse { from { box-shadow: inset -30px -40px 80px rgba(6, 17, 11, 0.45), 0 0 0 0 rgba(163, 214, 92, 0.35); } to { box-shadow: inset -30px -40px 80px rgba(6, 17, 11, 0.45), 0 0 0 28px rgba(163, 214, 92, 0); } }
  .ring { inset: 3% -4% 3% 0; pointer-events: none; }
  .ring svg { width: 100%; height: 100%; overflow: visible; }
  .word { left: -6%; right: -6%; top: 14%; text-align: center; font: 900 clamp(100px, 14vw, 210px)/0.8 var(--f-display); font-stretch: 125%; letter-spacing: -0.04em; color: rgba(237, 243, 230, 0.07); user-select: none; pointer-events: none; }
  .face { left: 7%; right: 3%; bottom: 0; display: flex; justify-content: center; pointer-events: none; }
  .face :global(picture) { display: contents; }
  .face :global(.cut) { width: 100%; max-width: 500px; height: auto; -webkit-mask-image: linear-gradient(#000 80%, transparent); mask-image: linear-gradient(#000 80%, transparent); filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.45)); }
  .ph { width: 100%; aspect-ratio: 1; display: grid; place-items: center; }
  .ph :global(svg) { width: 34%; height: auto; }
  .chip { background: rgba(12, 31, 21, 0.86); border: 1px solid var(--line-2); border-radius: 16px; padding: 12px 14px; display: grid; gap: 6px; box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.7); font-size: 14px; }
  @supports (backdrop-filter: blur(1px)) { .chip { background: rgba(12, 31, 21, 0.72); backdrop-filter: blur(12px); } }
  .chip .row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .chip b { font: 600 15px var(--f-text); }
  .meta { font: 500 14px var(--f-mono); color: var(--ink-mute); }
  .pill { display: inline-flex; align-items: center; gap: 6px; font: 600 14px var(--f-text); padding: 2px 9px; border-radius: 999px; background: rgba(139, 208, 106, 0.16); color: var(--ok); white-space: nowrap; transition: background-color 0.3s, color 0.3s; }
  .pill::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .pill.blue { background: rgba(90, 180, 255, 0.15); color: var(--spark); }
  .pill.warn { background: rgba(226, 184, 87, 0.15); color: var(--gold); }
  .chip :global(.flip) { animation: flip 0.45s ease; }
  @keyframes flip { from { opacity: 0; transform: translateY(6px); } }
  .c1 { left: 0; top: 66%; width: min(290px, 60%); }
  .c2 { right: -3%; top: 12%; width: min(240px, 50%); }
  .leafx svg { display: block; fill: var(--leaf); }
  .l1 { right: 4%; bottom: 8%; width: 64px; filter: blur(3px); opacity: 0.8; }
  .l2 { left: 2%; top: 6%; width: 40px; filter: blur(1.5px); opacity: 0.65; }
  .l3 { right: 30%; top: -2%; width: 26px; opacity: 0.5; }
  @media (max-width: 900px) {
    .stage { justify-self: center; max-width: 400px; }
    .c1 { left: -2%; top: 70%; width: 64%; }
    .c2 { right: -2%; top: 6%; width: 54%; }
    .chip { padding: 9px 11px; }
    .chip b, .meta, .pill { font-size: 14px; }
    .chip .row { flex-wrap: wrap; gap: 4px 10px; }
  }
  @media (prefers-reduced-motion: reduce) { .plane { transition: none; } }
</style>
