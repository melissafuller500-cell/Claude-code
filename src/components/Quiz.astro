---
/**
 * Test « Vos contrats vous protègent-ils ? » : six questions en boutons radio natifs.
 * Questions, conseils et grille de lecture sont dans le HTML ; le script calcule le score sur place.
 */
import quiz from '../data/quiz.json';
import { waLink } from '../data/site';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const L = en
  ? { yes: 'Yes', no: 'No', ifNo: 'If not:', score: 'Your score', of: 'out of 6', pending: 'Answer all six questions to see your score.', reset: 'Retake the test', wa: 'Send my result to Noé on WhatsApp', scale: 'How to read your score', note: 'This test gives an indication. It does not replace a review of your contracts.', advice: 'What to fix first', q: 'Question' }
  : { yes: 'Oui', no: 'Non', ifNo: 'Si non :', score: 'Votre score', of: 'sur 6', pending: 'Répondez aux six questions pour voir votre score.', reset: 'Refaire le test', wa: 'Envoyer mon résultat à Noé sur WhatsApp', scale: 'Comment lire votre score', note: 'Ce test donne une indication. Il ne remplace pas l’examen de vos contrats.', advice: 'À corriger en priorité', q: 'Question' };
const ranges = ['5–6', '3–4', '0–2'];
---
<form class="quiz" data-quiz data-lang={lang} onsubmit="return false" aria-label={en ? 'Contract test' : 'Test de contrat'}>
  <ol class="qs">
    {quiz.questions.map((q, i) => (
      <li>
        <fieldset>
          <legend><span class="n">{L.q} {i + 1} / 6</span>{en ? q.en : q.fr}</legend>
          <div class="seg">
            <label><input type="radio" name={`q${i}`} value="1" /><span>{L.yes}</span></label>
            <label><input type="radio" name={`q${i}`} value="0" /><span>{L.no}</span></label>
          </div>
          <p class="small adv" data-adv={i}><b>{L.ifNo}</b> {en ? q.adviceEn : q.adviceFr}</p>
        </fieldset>
      </li>
    ))}
  </ol>

  <aside class="result panel" aria-labelledby="q-score-h">
    <h2 id="q-score-h" class="rh">{L.score}</h2>
    <div class="ring" aria-hidden="true">
      <svg viewBox="0 0 120 120"><circle class="bg" cx="60" cy="60" r="52" /><circle class="fg" cx="60" cy="60" r="52" stroke-dasharray="326.7" stroke-dashoffset="326.7" data-q="ring" /></svg>
      <div><b class="num" data-q="n">0</b><span>{L.of}</span></div>
    </div>
    <div class="verdict" role="status" aria-live="polite" data-q="verdict"><p class="muted">{L.pending}</p></div>
    <div data-q="adviceBox" hidden><h3 class="ah">{L.advice}</h3><ul class="advice" data-q="advice"></ul></div>
    <div class="ctas" data-q="ctas" hidden>
      <a class="btn sm" data-q="wa" href={waLink()} target="_blank" rel="noopener" data-track="whatsapp_click" data-src="quiz">{L.wa}</a>
      <button class="btn sm ghost" type="reset">{L.reset}</button>
    </div>
    <h3 class="ah">{L.scale}</h3>
    <dl class="scale">
      {quiz.verdicts.map((v, i) => (
        <div class={v.tone}><dt>{ranges[i]} · {(en ? v.en : v.fr)[0]}</dt><dd>{(en ? v.en : v.fr)[1]}</dd></div>
      ))}
    </dl>
    <p class="small">{L.note}</p>
  </aside>
</form>
<script>
  import { lazy } from '../scripts/lazy';
  lazy('[data-quiz]', () => import('../scripts/quiz'));
</script>
<style>
  .quiz { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 16px; align-items: start; }
  .qs { list-style: none; padding: 0; display: grid; gap: 12px; }
  fieldset { border: 1px solid var(--line); border-radius: var(--r-m); background: var(--forest); padding: 20px 22px; margin: 0; display: grid; gap: 14px; }
  legend { float: left; width: 100%; padding: 0; font: 700 clamp(19px, 1.8vw, 22px)/1.3 var(--f-display); font-stretch: 104%; }
  .n { display: block; font: 600 14px var(--f-text); color: var(--ink-mute); letter-spacing: 0.06em; margin-bottom: 6px; }
  .adv b { color: var(--ink-soft); }
  fieldset:has(input[value='0']:checked) { border-color: rgba(229, 96, 79, 0.6); }
  fieldset:has(input[value='0']:checked) .adv { color: var(--ink); }
  fieldset:has(input[value='1']:checked) { border-color: rgba(139, 208, 106, 0.6); }
  .result { position: sticky; top: calc(var(--hdr) + 16px); display: grid; gap: 16px; background: var(--night); }
  .rh { font-size: 22px; }
  .ring { position: relative; width: 170px; height: 170px; margin: 0 auto; }
  .ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 9; }
  .ring .bg { stroke: var(--forest-2); }
  .ring .fg { stroke: var(--spark); stroke-linecap: round; transition: stroke-dashoffset 0.8s cubic-bezier(0.2, 0.8, 0.2, 1), stroke 0.4s; }
  .ring div { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .ring b { font: 900 54px/1 var(--f-display); font-stretch: 120%; }
  .ring span { font-size: 14px; color: var(--ink-mute); }
  .verdict { text-align: center; display: grid; gap: 6px; }
  .verdict :global(h3) { font-size: 28px; }
  .ah { font-size: 18px; }
  .advice { padding-left: 18px; display: grid; gap: 8px; color: var(--ink-soft); }
  .scale { margin: 0; display: grid; gap: 8px; }
  .scale div { border-left: 3px solid var(--ok); padding-left: 12px; }
  .scale .warn { border-color: var(--warn); }
  .scale .bad { border-color: var(--bad); }
  .scale dt { font-weight: 600; }
  .scale dd { margin: 0; color: var(--ink-soft); font-size: 15px; }
  @media (max-width: 900px) { .quiz { grid-template-columns: 1fr; } .result { position: static; } }
</style>
