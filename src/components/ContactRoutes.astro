---
/** Trois voies de contact, toujours visibles ensemble (section 13). */
import { useUI } from '../i18n/ui';
import { SITE, waLink, mailLink } from '../data/site';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang; formHref: string; src?: string; compact?: boolean }
const { lang, formHref, src = 'contact', compact = false } = Astro.props;
const t = useUI(lang);
---
<ul class:list={['routes', { compact }]} aria-label={t.contact.title}>
  <li>
    <a href={formHref} data-track="cta_click" data-src={src}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5zM8 9h8M8 13h8M8 17h5" /></svg>
      <span><b>{t.contact.form}</b>{!compact && <small>{t.cta}</small>}</span>
    </a>
  </li>
  <li>
    <a href={waLink(t.contact.waDefault)} target="_blank" rel="noopener" data-track="whatsapp_click" data-src={src} data-wa>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z" /></svg>
      <span><b>{t.contact.whatsapp}</b>{!compact && <small class="mono">{SITE.whatsapp.display}</small>}</span>
    </a>
  </li>
  <li>
    <a href={mailLink(t.contact.mailSubject)} data-track="email_click" data-src={src}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3zM3 7l9 7 9-7" /></svg>
      <span><b>{t.contact.email}</b>{!compact && <small class="mono">{SITE.email}</small>}</span>
    </a>
  </li>
</ul>
<style>
  .routes { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  a { display: flex; align-items: center; gap: 12px; min-height: 64px; padding: 12px 16px; border: 1px solid var(--line-2); border-radius: 16px; text-decoration: none; background: rgba(12, 31, 21, 0.6); transition: border-color 0.2s, background-color 0.2s; height: 100%; }
  a:hover { border-color: var(--leaf); background: var(--forest-2); }
  svg { width: 24px; height: 24px; flex: none; fill: none; stroke: var(--leaf); stroke-width: 1.8; stroke-linejoin: round; }
  span { display: grid; gap: 2px; min-width: 0; }
  b { font-weight: 600; font-size: 16px; }
  small { font-size: 14px; color: var(--ink-soft); overflow-wrap: anywhere; }
  .compact a { min-height: 52px; }
  @media (max-width: 760px) { .routes { grid-template-columns: 1fr; } }
</style>
