---
/**
 * Composant unique du <head> (section 10) : charset, viewport, title, description, canonique absolue,
 * Open Graph, Twitter, theme-color, favicon, hreflang, préchargement de la police du titre.
 */
import { SITE } from '../data/site';
import type { Lang } from '../i18n/routes';

export interface Alternates { fr?: string; en?: string }
interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;
  alternates?: Alternates;
  ogImage: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  published?: Date;
  modified?: Date;
}

const { title, description, lang, path, alternates = {}, ogImage, ogType = 'website', noindex = false, published, modified } = Astro.props;
const canonical = new URL(path, SITE.url).href;
// La marque n'est ajoutée que si le titre reste court (≈ 65 caractères affichés par Google).
const withBrand = `${title} · ${SITE.name}`;
const fullTitle = title.includes(SITE.name) || withBrand.length > 65 ? title : withBrand;
const ogUrl = new URL(ogImage, SITE.url).href;
const hasTranslation = Boolean(alternates.fr && alternates.en);
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{hasTranslation && (
  <>
    <link rel="alternate" hreflang="fr" href={new URL(alternates.fr!, SITE.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en!, SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.fr!, SITE.url).href} />
  </>
)}
<link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin />
<meta name="theme-color" content="#06110B" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={lang === 'en' ? `${SITE.name} · Blog (English)` : `${SITE.name} · Blog`} href={new URL(lang === 'en' ? '/en/rss.xml' : '/rss.xml', SITE.url).href} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'fr_FR'} />
{hasTranslation && <meta property="og:locale:alternate" content={lang === 'en' ? 'fr_FR' : 'en_GB'} />}
<meta property="og:image" content={ogUrl} />
<meta property="og:image:secure_url" content={ogUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{(modified ?? published) && <meta property="article:modified_time" content={(modified ?? published)!.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
{beacon && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
