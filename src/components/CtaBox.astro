---
/** Encadré d'appel au diagnostic (articles, guides, outils). Zéro JavaScript. */
import ContactRoutes from './ContactRoutes.astro';
import { useUI } from '../i18n/ui';
import { r, type Lang } from '../i18n/routes';
interface Props { lang: Lang; title?: string; text?: string; src?: string }
const { lang, src = 'content' } = Astro.props;
const t = useUI(lang);
const title = Astro.props.title ?? t.ctaBoxTitle;
const text = Astro.props.text ?? t.ctaBoxText;
---
<aside class="ctabox" aria-label={title}>
  <p class="h">{title}</p>
  <p class="muted">{text}</p>
  <a class="btn" href={`${r('diagnostic', lang)}#formulaire`} data-track="cta_click" data-src={src}>{t.cta}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
  <ContactRoutes {lang} formHref={`${r('diagnostic', lang)}#formulaire`} {src} compact />
</aside>
<style>
  .ctabox { margin-block: 40px; padding: clamp(22px, 3vw, 32px); border-radius: var(--r-l); background: radial-gradient(90% 120% at 0% 100%, #1b4128 0%, var(--forest) 70%); border: 1px solid rgba(163, 214, 92, 0.35); display: grid; gap: 14px; justify-items: start; }
  .h { font: 800 clamp(22px, 2.4vw, 28px)/1.15 var(--f-display); font-stretch: 110%; letter-spacing: -0.01em; }
  .ctabox :global(.routes) { width: 100%; margin-top: 6px; }
</style>
