---
/**
 * Marque provisoire dessinée à partir de la feuille du site d'origine.
 * À remplacer par le logo officiel : déposer src/assets/brand/logo-mark.(webp|png|svg).
 */
import { brand } from '../lib/brand';
import { Image } from 'astro:assets';
interface Props { size?: number; class?: string }
const { size = 30, class: cls } = Astro.props;
const h = Math.round(size * 1.25);
---
{brand.logo ? (
  <Image src={brand.logo} alt="" width={size} height={h} class={cls} loading="eager" />
) : (
  <svg class={cls} width={size} height={h} viewBox="0 0 32 40" aria-hidden="true" focusable="false">
    <path d="M16 1C27 9 29 25 16 39 3 25 5 9 16 1Z" fill="#A3D65C" />
    <path d="M16 6v31" stroke="#0B1A0F" stroke-width="1.6" stroke-linecap="round" opacity=".55" />
    <circle cx="16" cy="19" r="4.2" fill="#5AB4FF" stroke="#06110B" stroke-width="1.6" />
  </svg>
)}
