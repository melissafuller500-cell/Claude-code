---
import { OFFERS } from '../data/offers';
import { fmtN } from '../lib/format';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang; headingLevel?: 'h2' | 'h3' }
const { lang, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const en = lang === 'en';
---
<div class="offers">
  {OFFERS.map((o) => (
    <article class:list={['offer', { feat: o.featured }]}>
      {o.featured && <span class="badge">{en ? 'The core of the method' : 'Le cœur de la méthode'}</span>}
      <span class="st">{o.step[lang]}</span>
      <H class="oh">{o.name[lang]}</H>
      <p class="price num">
        {o.from && <span class="from">{en ? 'From' : 'À partir de'}</span>}
        {fmtN(o.price, lang)} <small>{o.perMonth ? (en ? 'FCFA / month' : 'FCFA / mois') : 'FCFA'}</small>
      </p>
      <p class="muted">{o.summary[lang]}</p>
      <ul>{o.items.map((i) => <li>{i[lang]}</li>)}</ul>
      {o.note && <p class="small">{o.note[lang]}</p>}
    </article>
  ))}
</div>
<style>
  .offers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
  .offer { background: var(--night); border: 1px solid var(--line); border-radius: var(--r-l); padding: 28px 26px; display: grid; gap: 14px; align-content: start; position: relative; }
  .offer.feat { background: linear-gradient(160deg, #1b4128, #0c2416 70%); border-color: rgba(163, 214, 92, 0.5); }
  .st { font: 600 14px var(--f-text); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mute); }
  .oh { font-size: 24px; }
  .price { font: 900 clamp(38px, 4vw, 52px)/1 var(--f-display); font-stretch: 118%; letter-spacing: -0.03em; display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; }
  .price small { font: 600 15px var(--f-text); letter-spacing: 0; color: var(--ink-soft); }
  .from { display: block; width: 100%; font: 600 14px var(--f-text); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-mute); }
  ul { list-style: none; padding: 16px 0 0; border-top: 1px solid var(--line); display: grid; gap: 10px; font-size: 16px; color: var(--ink-soft); }
  li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 10px; }
  li::before { content: ''; width: 12px; height: 7px; margin-top: 8px; border: 2px solid var(--leaf); border-top: 0; border-right: 0; transform: rotate(-45deg); }
  .badge { position: absolute; top: -14px; left: 24px; background: var(--leaf); color: var(--on-leaf); font: 600 14px var(--f-text); padding: 5px 12px; border-radius: 999px; }
  @media (max-width: 960px) { .offers { grid-template-columns: 1fr; } .offer.feat { margin-top: 8px; } }
</style>
