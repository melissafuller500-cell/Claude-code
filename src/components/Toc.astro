---
import type { MarkdownHeading } from 'astro';
import { useUI } from '../i18n/ui';
import type { Lang } from '../i18n/routes';
interface Props { headings: MarkdownHeading[]; lang: Lang }
const { headings, lang } = Astro.props;
const h2 = headings.filter((h) => h.depth === 2);
const t = useUI(lang);
---
{h2.length > 2 && (
  <nav class="toc" aria-labelledby="toc-h">
    <p id="toc-h" class="k">{t.toc}</p>
    <ol>{h2.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
  </nav>
)}
<style>
  .toc { border: 1px solid var(--line); border-radius: var(--r-m); padding: 18px 22px; background: var(--forest); max-width: 72ch; }
  .k { font: 600 14px var(--f-text); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mute); margin-bottom: 8px; }
  ol { padding-left: 22px; display: grid; gap: 0; }
  a { display: inline-flex; min-height: 40px; align-items: center; color: var(--ink-soft); text-decoration: none; }
  a:hover { color: var(--leaf); text-decoration: underline; }
</style>
