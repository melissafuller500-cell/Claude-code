---
/** Générateur de clauses : toutes les clauses sont dans le HTML ; cocher compose l'article à copier. */
import data from '../data/clauses.json';
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const draft = (ids: boolean[]) => {
  const on = data.clauses.filter((_, i) => ids[i]);
  return on.length ? `${data.heading[lang]}\n\n${on.map((c, i) => `${i + 1}. ${c[lang].text}`).join('\n\n')}` : data.empty[lang];
};
const initial = draft(data.clauses.map((c) => c.default));
const L = en
  ? { pick: 'Tick the clauses you want. The article below assembles them, ready to copy.', draft: 'Draft · Payment terms', copy: 'Copy', wording: 'Wording' }
  : { pick: 'Cochez les clauses voulues. L’article ci-dessous les assemble, prêt à copier.', draft: 'Projet · Conditions de paiement', copy: 'Copier', wording: 'Formulation' };
---
<div class="cb" data-clauses data-lang={lang}>
  <fieldset class="cls">
    <legend class="small">{L.pick}</legend>
    {data.clauses.map((c, i) => (
      <label class="cl">
        <input type="checkbox" name="clause" value={c.id} checked={c.default} />
        <span><b>{c[lang].title}</b><span class="why">{c[lang].why}</span><span class="txt"><em>{L.wording} :</em> {c[lang].text}</span></span>
      </label>
    ))}
  </fieldset>
  <figure class="draft">
    <figcaption>
      <span>{L.draft}</span>
      <span class="meter" aria-hidden="true" data-meter>{data.clauses.map((c) => <i class={c.default ? 'on' : ''}></i>)}</span>
      <button class="copy" type="button" data-copy="#cl-draft">{L.copy}</button>
    </figcaption>
    <pre id="cl-draft" aria-live="polite">{initial}</pre>
    <p class="small">{data.warning[lang]}</p>
  </figure>
</div>
<script>
  import { lazy } from '../scripts/lazy';
  import { bindCopy } from '../scripts/copy';
  bindCopy();
  lazy('[data-clauses]', () => import('../scripts/clauses'));
</script>
<style>
  .cb { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: start; }
  .cls { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .cls legend { margin-bottom: 10px; }
  .cl { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; padding: 16px; border: 1px solid var(--line); border-radius: 14px; cursor: pointer; background: var(--forest); transition: border-color 0.2s, background-color 0.2s; }
  .cl:has(input:checked) { border-color: var(--leaf); background: rgba(163, 214, 92, 0.07); }
  .cl input { width: 22px; height: 22px; margin: 2px 0 0; accent-color: var(--leaf); }
  .cl > span { display: grid; gap: 4px; }
  .cl b { font-size: 16px; }
  .why { font-size: 15px; color: var(--ink-soft); }
  .txt { font-size: 14px; color: var(--ink-mute); }
  .txt em { font-style: normal; font-weight: 600; }
  .draft { margin: 0; position: sticky; top: calc(var(--hdr) + 16px); background: #f6f8f1; color: var(--paper-ink); border-radius: var(--r-m); padding: 22px 24px; display: grid; gap: 14px; }
  .draft figcaption { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font: 600 14px var(--f-text); letter-spacing: 0.06em; text-transform: uppercase; color: var(--paper-soft); }
  .meter { display: flex; gap: 4px; margin-right: auto; }
  .meter i { width: 16px; height: 6px; border-radius: 3px; background: rgba(18, 36, 26, 0.14); }
  .meter i.on { background: var(--leaf-ink); }
  .draft .copy { color: var(--paper-ink); border-color: rgba(18, 36, 26, 0.3); text-transform: none; letter-spacing: 0; }
  .draft .copy:hover { background: var(--paper-2); }
  .draft .copy.done { background: var(--leaf-ink); color: #fff; }
  pre { margin: 0; white-space: pre-wrap; word-break: break-word; font: 400 15px/1.65 var(--f-mono); }
  .draft .small { color: var(--paper-soft); }
  .draft :focus-visible { outline-color: #1f6fb8; }
  @media (max-width: 900px) { .cb { grid-template-columns: 1fr; } .draft { position: static; } }
</style>
