---
// Written pages: dark title band, light body.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
interface Props { title: string; description: string; h1: string; crumb: string; lead?: string; noindex?: boolean }
const { title, description, h1, crumb, lead, noindex } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <section class="dark-frame relative overflow-hidden bg-ink-900 text-white">
    <div class="pointer-events-none absolute -right-32 -top-32 h-[380px] w-[380px] rounded-full bg-line-yellow/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-bay relative py-10 md:py-14">
      <Breadcrumbs dark items={[{ name: 'Home', href: '/' }, { name: crumb, href: Astro.url.pathname }]} />
      <h1 class="mt-4 max-w-4xl text-5xl text-white md:text-6xl">{h1}</h1>
      {lead && <p class="mt-4 max-w-2xl text-lg text-on-dark-muted">{lead}</p>}
    </div>
  </section>
  <div class="container-bay py-10 md:py-14">
    <slot />
  </div>
</BaseLayout>
