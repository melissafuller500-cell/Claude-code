# DoseUses.com server rules (Apache / LiteSpeed)

AddDefaultCharset UTF-8
AddCharset UTF-8 .html .xml .txt .webmanifest
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

# One canonical origin: https://doseuses.com/
# Sends http://, www., and any old domain (e.g. allmedsmarket.com) to it with a single 301.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^doseuses\.com$ [NC]
  RewriteRule ^ https://doseuses.com%{REQUEST_URI} [L,R=301,NE]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header unset X-Powered-By

  <FilesMatch "\.(woff2|png|svg|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml application/rss+xml image/svg+xml application/manifest+json
</IfModule>
