# Copy to .env for local development. On Hostinger, set these as environment variables.
# None of these values may be committed or exposed to client code.

# Launch mode: orders are confirmed on WhatsApp. Switch to "stripe" when card checkout goes live.
PAYMENT_MODE=whatsapp
WHATSAPP_NUMBER=

SITE_URL=https://baystockparts.com

# Order emails (Hostinger SMTP)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFY_EMAIL=

# Chatbot
ANTHROPIC_API_KEY=

# Required only when PAYMENT_MODE=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set to "production" to exclude sample products and kits from the build
BAYSTOCK_ENV=
