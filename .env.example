# BayStock Auto Parts: environment variables.
# On Hostinger, enter these in the Node.js app's Environment variables panel.
# For a local run, copy this file to .env. Never commit real values.

# ── Required at launch ─────────────────────────────────────────
SITE_URL=https://baystockparts.com
PAYMENT_MODE=whatsapp
# WhatsApp Business number in international format, digits only (e.g. 15551234567)
WHATSAPP_NUMBER=

# Order emails (Hostinger SMTP: smtp.hostinger.com, port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: From address if different from SMTP_USER
SMTP_FROM=
# Where the owner's copy of every order and contact message is sent
ORDER_NOTIFY_EMAIL=

# Folder for the order log (outside the public site). Use a path that survives redeploys.
ORDER_LOG_DIR=./orders
ORDER_TIMEZONE=America/New_York

# ── Parts assistant (chatbot) ──────────────────────────────────
# Set a monthly spending cap on this key in the Claude Console.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5

# ── Catalog ────────────────────────────────────────────────────
# Set to "production" once data/products.csv holds the real catalog: sample rows are then left out.
BAYSTOCK_ENV=

# ── Analytics (optional; loaded only after cookie consent) ─────
PUBLIC_GA4_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# ── Card checkout (only when PAYMENT_MODE=stripe) ──────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Send HSTS and upgrade-insecure-requests even if the proxy does not set X-Forwarded-Proto
FORCE_HTTPS=
