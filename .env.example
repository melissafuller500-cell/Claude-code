# Copy to .env (or set in your hosting dashboard). Node does not load .env automatically:
# use `node --env-file=.env server.js` or your platform's env settings.
NODE_ENV=production
PORT=3000
SITE_URL=https://investnreturns.com
SESSION_SECRET=replace-with-64-random-characters
ADMIN_EMAIL=admin@investnreturns.com
ADMIN_PASSWORD=replace-with-a-strong-password
SEED_DEMO=false
# DB_FILE=/var/data/inr.db
# TRUST_PROXY=1

# Deposit details shown on reservation pages (leave empty to say "we will send details").
PAY_USDT_ADDRESS=
PAY_USDC_ADDRESS=
PAY_BTC_ADDRESS=
PAY_ETH_ADDRESS=
PAY_MOMO_NUMBER=
PAY_ORANGE_NUMBER=
PAY_BANK_IBAN=
PAY_CARD_LINK=
